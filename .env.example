# --- Discord (required) ---
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=

# --- Schedule (Asia/Tokyo by default) ---
TIME_ZONE=Asia/Tokyo
DIGEST_HOUR=7
DIGEST_MINUTE=0
ALERT_POLL_MINUTES=60

# --- Storage & logs ---
DATA_DIR=./data
LOG_LEVEL=info

# --- Optional ---
# Raises LMArena (Hugging Face datasets-server) rate limits when set.
HUGGINGFACE_TOKEN=
# 設定すると AA Intelligence / AA Coding ボードを追加。未設定でも LMArena は従来どおり投稿
AA_API_KEY=
