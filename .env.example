# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Runtime
DATABASE_PATH=./data/bot.sqlite
BACKUP_DIR=./backups
TIME_ZONE=Asia/Tokyo
DIGEST_HOUR=7
DIGEST_MINUTE=0
LOG_LEVEL=info

# Optional: raises GitHub/Hugging Face API limits when configured.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# Staged adapters. Meta and Qwen remain off until contract checks pass.
ENABLE_META=false
ENABLE_QWEN=false
