# Copy to /etc/ai-benchmark-bot.env and set mode 0600.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CHANNEL_ID=replace-with-notification-channel-id

DATA_DIR=/var/lib/ai-benchmark-bot/data
TIME_ZONE=Asia/Tokyo
DIGEST_HOUR=7
DIGEST_MINUTE=0
ALERT_POLL_MINUTES=60
LOG_LEVEL=info

# Optional. Raises LMArena (Hugging Face datasets-server) rate limits.
HUGGINGFACE_TOKEN=
