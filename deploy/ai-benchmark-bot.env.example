# Copy to /etc/ai-benchmark-bot.env and set mode 0600.
DISCORD_TOKEN=replace-with-discord-bot-token
DISCORD_CLIENT_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-personal-server-id

DATABASE_PATH=/var/lib/ai-benchmark-bot/bot.sqlite
BACKUP_DIR=/var/lib/ai-benchmark-bot/backups
TIME_ZONE=Asia/Tokyo
DIGEST_HOUR=7
DIGEST_MINUTE=0
LOG_LEVEL=info

# Optional. Supplying tokens raises API limits but is not required for the MVP.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=

# These adapters remain disabled until their 7-day contract smoke test succeeds.
ENABLE_META=false
ENABLE_QWEN=false

# Opt-in only after reviewing each provider's current terms of use.
ENABLE_ZAI=false
ENABLE_MOONSHOT=false
